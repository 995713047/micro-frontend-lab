    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "babel-loader": "^9.2.0",
    "css-loader": "^6.11.0",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.0",
    "webpack": "^5.100.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^5.2.0"
  }
}
